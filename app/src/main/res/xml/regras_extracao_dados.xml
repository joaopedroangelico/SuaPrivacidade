<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nada vai para o backup na nuvem; a transferência direta entre aparelhos
     (troca de celular, feita pelo próprio usuário) continua levando os dados. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" />
        <include domain="file" />
    </device-transfer>
</data-extraction-rules>
